# Server only. Never prefix these with VITE_.
ANALYTICS_ENABLED=false
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# UUID of an existing Supabase Auth administrator; comma-separated for multiple admins.
ANALYTICS_ADMIN_IDS=
# Generate 32 random bytes (hex). Keep private and stable across deployments.
ANALYTICS_SIGNING_SECRET=
ANALYTICS_ORIGIN=http://127.0.0.1:5182
# Production: https://landingpage-conselt-automa-or.vercel.app (no custom DNS required).
# Leave unset locally to share the local origin.
ANALYTICS_ADMIN_ORIGIN=
# Optional public collector address for a future custom domain; this is not a secret.
# VITE_ANALYTICS_BASE_URL=https://painel.conselt.com.br
